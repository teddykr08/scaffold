# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Hide user and repo artifacts requested by cleanup
*.md
!.github
!README.md
!LICENSE.md
.env*
!.env.example
*.log
*.log.*
Thumbs.db
*.sqlite
*.sql
__pycache__/
.pytest_cache/
tests/
**/__tests__/
playwright-report/
test-results/
screenshots/
docs/
scripts/

# Ignore archived node_modules created by cleanup scripts
archive_cleanup_*/node_modules/
archive_cleanup_*/tests/
archive_cleanup_*/playwright-report/
archive_cleanup_*/test-results/
archive_cleanup_*/scripts/


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts





